APP_NAME=FurShield
APP_ENV=local
APP_KEY=
# Keep APP_DEBUG=false for any shared, graded, or production deploy.
# Debug pages and stack traces must not be reachable outside a machine you control.
# A private local demo may set APP_DEBUG=true while APP_ENV=local.
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Supabase is Postgres. The REST URL is the project address, not the database password.
# Fill DB_PASSWORD from Supabase → Project Settings → Database. Do not commit it.
# The direct host is IPv6-only. On IPv4, use the Session pooler host and port from that same page.
# DB_CONNECTION=pgsql
# DB_HOST=db.jnttninqzqmkbtoivujv.supabase.co
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres
# DB_PASSWORD=
# DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Gmail SMTP. Leave these empty to keep mail in the log. See EMAIL_SETUP.md.
# SMTP_SECURE=false uses STARTTLS on port 587. Do not commit the app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# MAIL_FROM="FurShield <you@gmail.com>"

# Google sign-in. The client id is public. Do not put a client secret here.
# GOOGLE_CLOCK_TOLERANCE_SEC covers a wrong computer clock. 60 is enough when the clock is right.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLOCK_TOLERANCE_SEC=60

# Gemini. The key is read by Laravel only. Do not prefix it with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

FURSHIELD_CURRENCY_SYMBOL="$"
FURSHIELD_SUPPORT_PHONE="+92-21-111-387-743"
FURSHIELD_EMERGENCY_PHONE=

# Optional owner assistant. Leave this false for a demo that has no model key.
# The key is read by Laravel only. Do not rename it to a VITE_ variable.
FURSHIELD_ASSISTANT_ENABLED=false
FURSHIELD_ASSISTANT_API_KEY=
FURSHIELD_ASSISTANT_BASE_URL=https://api.openai.com/v1
FURSHIELD_ASSISTANT_MODEL=gpt-4o-mini
FURSHIELD_ASSISTANT_PER_MINUTE=12
